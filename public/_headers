# Netlify / Cloudflare Pages: Service Worker und Einstiegsseite nie lange cachen,
# damit Updates ankommen. Gehashte Assets dürfen dauerhaft gecacht werden.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
