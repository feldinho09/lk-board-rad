{
  "name": "lk-board-rad",
  "private": true,
  "version": "0.1.0",
  "description": "LK Board Rad – Offline-fähiges Kommentatorenwerkzeug für Radrennen (Browser-App)",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
